# DiveintoInfinity Studio - Environment Configuration
# Copy this file to .env.local to configure local development or production secrets.

# Primary recipient email for project inquiries received through the contact form
CONTACT_EMAIL=hello@diveintoinfinity.com

# Optional: Resend API Key (https://resend.com) for sending notification emails automatically
# RESEND_API_KEY=re_your_api_key_here

# Optional: Webhook URL (e.g., Slack incoming webhook, Discord, Zapier, or CRM)
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Production Domain Base URL
NEXT_PUBLIC_SITE_URL=https://diveintoinfinity.com

# Express API server URL. The web app proxies /api/server/* here via rewrites.
# Default for local dev: http://localhost:3000 (apps/server)
API_URL=http://localhost:3000
